# Python
venv/
.venv/
__pycache__/
*.pyc

# YOLO
runs/
resultats/
*.pt
!iot/models/*.pt

# Données locales
iot/photos_test/
iot/places.json
.env

# Serveur (server/) : certificats, clés et secrets jamais dans Git
server/certs/
server/certbot-www/
# Clés RSA des JWT (scripts/generate-jwt-keys.sh, server/jwt/keys/<kid>.pem) : les clés privées signent les jetons
server/jwt/
*.pem
*.key

# Java (modules iam, core, api)
target/

# Éditeurs
.idea/
.vscode/

# Dataset IoT (images sous licence ou sous droits d'auteur : jamais dans Git)
iot/dataset/*
!iot/dataset/data.yaml.exemple
# Sorties de l'évaluation des modèles (images du dataset annotées) : jamais dans Git
iot/entrainement/sorties/
iot/.env
# Exports de Label Studio (ses données sont dans %USERPROFILE%\label-studio-data, hors du dépôt)
*.label-studio.json
