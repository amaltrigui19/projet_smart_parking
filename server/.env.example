# Copier ce fichier en .env (jamais commité) puis remplacer les valeurs.
# Mots de passe : lettres et chiffres seulement (pas de @ : / # ni d'espace).
# Pour en générer un : openssl rand -hex 16

# Nom du serveur : localhost en local (voie B) ;
# sur la VM AWS (voie A) : DOMAIN=smartparking-supcom.duckdns.org
DOMAIN=localhost

# MongoDB (compte administrateur créé au premier démarrage)
MONGO_USER=admin
MONGO_PASSWORD=a_remplacer
# Port de MongoDB sur la machine hôte. Laisser 127.0.0.1 : la base n'est pas
# exposée sur le réseau (sur la VM, passer par un tunnel SSH).
MONGO_HOST_PORT=127.0.0.1:27017

# Mosquitto : un compte pour le Raspberry Pi (pi), un pour le serveur (server)
MQTT_PASSWORD_PI=a_remplacer
MQTT_PASSWORD_SERVER=a_remplacer

# JWT : les clés ne vont PAS ici. Les générer avec ./scripts/generate-jwt-keys.sh,
# qui les écrit dans server/jwt/keys/ (ignoré par Git), monté dans WildFly par docker-compose.yml.

# Compte OPERATOR de démonstration, créé au démarrage de WildFly s'il n'existe pas.
# Laisser vide pour ne rien créer. Mot de passe : 8 caractères au moins (openssl rand -hex 12).
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# Image WildFly. Laisser commenté en local (l'image est construite depuis middleware/).
# Sur la VM, la ligne est écrite par scripts/deploy.sh à chaque déploiement (voir server/README.md, CI/CD).
# WILDFLY_IMAGE=ghcr.io/amaltrigui19/projet_smart_parking/wildfly:<commit>

# Sprints suivants (ne pas remplir maintenant)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:
