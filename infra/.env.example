# Copier ce fichier en .env (jamais commité) puis remplacer les valeurs.
# Mots de passe : lettres et chiffres seulement (pas de @ : / # ni d'espace).
# Pour en générer un : openssl rand -hex 16

# Nom du serveur : localhost en local (voie B) ;
# sur la VM AWS (voie A) : DOMAINE=smartparking-supcom.duckdns.org
DOMAINE=localhost

# MongoDB (compte administrateur créé au premier démarrage)
MONGO_UTILISATEUR=admin
MONGO_MOT_DE_PASSE=a_remplacer
# Port de MongoDB sur la machine hôte. Laisser 127.0.0.1 : la base n'est pas
# exposée sur le réseau (sur la VM, passer par un tunnel SSH).
MONGO_PORT_HOTE=127.0.0.1:27017

# Mosquitto : un compte pour le Raspberry Pi, un pour le serveur
MQTT_MDP_PI=a_remplacer
MQTT_MDP_SERVEUR=a_remplacer

# Sprints suivants (ne pas remplir maintenant)
# JWT_CLE_PRIVEE=
# VAPID_CLE_PUBLIQUE=
# VAPID_CLE_PRIVEE=
# VAPID_SUJET=mailto:
